<Window x:Class="PCAndroidRooter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:PCAndroidRooter.Models"
        xmlns:converters="clr-namespace:PCAndroidRooter.Converters"
        Title="PC Android Rooter"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        TextElement.FontFamily="{DynamicResource MaterialDesignBodyFont}"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />

        <!-- Spin animation for rooting overlay -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════ HEADER ═══════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/android_capsule_icon.ico" Width="28" Height="28" Margin="0,0,12,0"/>
                    <TextBlock Text="PC Android Rooter" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Android" Width="18" Height="18"
                        Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusToColor}}" />
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="13"
                               Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding ConnectionStatus, Converter={StaticResource StatusToColor}}"
                             Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="18" Height="18">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#EF5350"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceRooted}" Value="True">
                                        <Setter Property="Foreground" Value="#66BB6A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock Text="Root detectado" FontSize="13" Foreground="#66BB6A"
                               Margin="6,0,0,0"
                               Visibility="{Binding IsDeviceRooted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ────────── LEFT PANEL: Device + Info ────────── -->
            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="16" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Device Selector -->
                        <TextBlock Text="DISPOSITIVO" Style="{StaticResource SectionTitle}" />

                        <ComboBox ItemsSource="{Binding DeviceList}"
                                  SelectedItem="{Binding SelectedSerial, UpdateSourceTrigger=PropertyChanged}"
                                  materialDesign:HintAssist.Hint="Seleccionar dispositivo"
                                  Style="{StaticResource MaterialDesignComboBox}"
                                  Margin="0,0,0,12"
                                  Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Conecta un dispositivo Android por USB"
                                   FontSize="13" Opacity="0.6" TextWrapping="Wrap"
                                   Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                   Margin="0,8,0,12" />

                        <!-- Quick Actions -->
                        <WrapPanel Margin="0,0,0,12">
                            <Button Command="{Binding RestartAdbCommand}" ToolTip="Reiniciar ADB"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" Margin="0,0,4,4">
                                <materialDesign:PackIcon Kind="Usb" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding RefreshDeviceCommand}" ToolTip="Actualizar información"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" Margin="0,0,4,4">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding RebootDeviceCommand}" ToolTip="Reiniciar dispositivo"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" Margin="0,0,4,4">
                                <materialDesign:PackIcon Kind="Restart" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding RebootBootloaderCommand}" ToolTip="Reiniciar a bootloader"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="8,4" Margin="0,0,4,4">
                                <materialDesign:PackIcon Kind="DeveloperBoard" Width="18" Height="18" />
                            </Button>
                        </WrapPanel>

                        <!-- Device Info Section -->
                        <TextBlock Text="TU DISPOSITIVO" Style="{StaticResource SectionTitle}"
                                   Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}" />

                        <!-- What is root? panel for new users -->
                        <Border CornerRadius="6" Background="#1E88E5" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="💡 ¿Qué es el root?" FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="El root te da control total sobre tu teléfono. Puedes eliminar apps que no se pueden borrar, personalizar el sistema y hacer backups completos."
                                           FontSize="11" Foreground="#E3F2FD" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Teléfono:" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceManufacturer}" Style="{StaticResource InfoValue}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Modelo:" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceModel}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Android:" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceAndroidVersion}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Batería:" Style="{StaticResource InfoLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceBattery}" Style="{StaticResource InfoValue}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Root:" Style="{StaticResource InfoLabel}" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="✓ Ya tiene root" Foreground="#66BB6A" FontWeight="Bold"
                                           Visibility="{Binding IsDeviceRooted, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="✗ Sin root" Foreground="#EF5350" FontWeight="Bold"
                                           Visibility="{Binding IsDeviceRooted, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Bloqueo:" Style="{StaticResource InfoLabel}" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Desbloqueado" Foreground="#66BB6A" FontWeight="Bold"
                                           Visibility="{Binding BootloaderUnlocked, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Bloqueado" Foreground="#FFA726" FontWeight="Bold"
                                           Visibility="{Binding BootloaderUnlocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </Grid>

                        <!-- ADB Progress -->
<ProgressBar IsIndeterminate="True"
                                      Visibility="{Binding IsAdbReady, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                      Margin="0,8,0,0" />

                         <!-- Backup & Restore Section -->
                         <TextBlock Text="BACKUP Y RESTAURACIÓN" Style="{StaticResource SectionTitle}"
                                    Margin="0,16,0,4" />
                         <StackPanel Margin="0,0,0,12">
                             <TextBox Text="{Binding BackupDirectory}"
                                      materialDesign:HintAssist.Hint="Directorio de backup"
                                      Style="{StaticResource MaterialDesignTextBox}"
                                      FontSize="12"
                                      Height="32"
                                      IsReadOnly="True" />
                             <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                 <Button Command="{Binding BrowseBackupDirectoryCommand}"
                                         Content="Buscar"
                                         Style="{StaticResource MaterialDesignFlatButton}"
                                         Padding="12,4"
                                         Margin="0,0,6,0"
                                         Width="80" />
                                 <Button Command="{Binding RestoreBackupCommand}"
                                         Content="Restaurar"
                                         Style="{StaticResource MaterialDesignFlatButton}"
                                         Background="{DynamicResource PrimaryHueMidBrush}"
                                         Foreground="White"
                                         Padding="12,4"
                                         Width="80" />
                                 <Button Command="{Binding RestoreOriginalBootCommand}"
                                         Content="Restaurar boot"
                                         Style="{StaticResource MaterialDesignFlatButton}"
                                         Padding="12,4"
                                         Margin="6,0,0,0" />
                             </StackPanel>
                         </StackPanel>

                     </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ────────── RIGHT PANEL: Root Methods ────────── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0">

                    <!-- ═══════════════════ BIG ONE-CLICK BUTTON ═══════════════════ -->
                    <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                            Background="{DynamicResource PrimaryHueMidBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Root automático" FontSize="18" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Desbloquea si hace falta y luego instala Magisk. Desbloquear borra el teléfono."
                                       FontSize="13" Foreground="#E3F2FD" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border Background="#E65100" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="Si está cerrado, borra" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#43A047" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="Si ya está abierto, no" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#43A047" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="Luego Magisk real" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <Button Command="{Binding OneClickRootCommand}"
                                    Content="ROOTear mi teléfono"
                                    FontSize="18" FontWeight="Bold"
                                    Padding="40,14"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    Cursor="Hand"
                                    Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Conecta un teléfono por USB para comenzar"
                                       FontSize="13" Foreground="#B3FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <TextBlock Text="Tras el borrado hay que volver a activar la depuración USB. La segunda pulsación solo instala Magisk."
                                       FontSize="11" Foreground="#FFECB3" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding IsDeviceConnected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OTRAS ACCIONES" Style="{StaticResource SectionTitle}" Opacity="0.6"/>
                    <TextBlock Text="Magisk y el arranque temporal no borran datos. Desbloquear el bootloader y MediaTek sí formatean el teléfono."
                               FontSize="12" Opacity="0.6" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- Recommended Method (highlighted) -->
                    <ItemsControl ItemsSource="{Binding RootMethods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RootMethod}">
                                <Border CornerRadius="8" BorderThickness="2"
                                        Padding="16" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1E88E5"/>
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="42" Height="42"
                                                    CornerRadius="21"
                                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Name + Desc -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FriendlyName}"
                                                               FontSize="15" FontWeight="SemiBold" />
                                                    <Border Background="#1E88E5" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="RECOMENDADO" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FriendlyDescription}"
                                                           FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <!-- Difficulty + Risk -->
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Background="#E8F5E9" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock FontSize="10" Foreground="#2E7D32">
                                                            <Run Text="Dificultad: "/><Run Text="{Binding Difficulty, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border CornerRadius="3" Padding="4,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Alto">
                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="Medio">
                                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10">
                                                            <Run Text="Riesgo: "/><Run Text="{Binding RiskLevel, Mode=OneWay}" FontWeight="SemiBold">
                                                                <Run.Foreground>
                                                                    <Binding Path="RiskLevel">
                                                                        <Binding.Converter>
                                                                            <converters:RiskToColorConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Run.Foreground>
                                                            </Run>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusColor}"
                                                         HorizontalAlignment="Center"
                                                         Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11" Opacity="0.7"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Command="{Binding DataContext.ExecuteRootMethodCommand,
                                            RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Content="EJECUTAR"
                                            IsEnabled="{Binding IsAvailable}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Background="{DynamicResource PrimaryHueMidBrush}"
                                            Foreground="White"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding DataContext.IsDeviceConnected,
                                                RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}},
                                                Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════ STATUS BAR ═══════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="Information" Width="16" Height="16"
                    Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <WrapPanel Grid.Column="2">
                    <Button Command="{Binding OpenLogFolderCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2"
                            ToolTip="Abrir carpeta de logs" FontSize="11" Margin="0,0,4,0">
                        📁 LOGS
                    </Button>
                    <Button Command="{Binding ClearLogCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2"
                            ToolTip="Limpiar log" FontSize="11">
                        LIMPIAR
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ LOG CONSOLE ═══════════════════ -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="#1E1E1E" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#252526" Padding="12,6">
                    <Grid>
                        <TextBlock Text="CONSOLA" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#888" VerticalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     Visibility="{Binding IsRooting, Converter={StaticResource BoolToVis}}"
                                     VerticalAlignment="Bottom" Margin="0,6,0,-8" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="LogScrollViewer">
                     <TextBox Text="{Binding LogText, Mode=OneWay}"
                              FontFamily="Cascadia Code, Consolas, Courier New"
                              FontSize="13"
                              Background="Transparent"
                              Foreground="#F0F0F0"
                              BorderThickness="0"
                              IsReadOnly="True"
                              Padding="12,8"
                              TextWrapping="Wrap"
                              VerticalScrollBarVisibility="Hidden"
                                      materialDesign:TextFieldAssist.HasClearButton="False" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════ ROOTING OVERLAY ═══════════════════ -->
        <Border Grid.RowSpan="4"
                Background="#AA000000"
                Visibility="{Binding IsRooting, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                <materialDesign:PackIcon Kind="ShieldSync" Width="64" Height="64"
                    Foreground="{DynamicResource PrimaryHueMidBrush}">
                    <materialDesign:PackIcon.RenderTransform>
                        <RotateTransform x:Name="SpinTransform" Angle="0" />
                    </materialDesign:PackIcon.RenderTransform>
                </materialDesign:PackIcon>
                <TextBlock Text="EJECUTANDO ROOT..." FontSize="24" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,8" />
                <TextBlock Text="No desconectes el teléfono ni cierres la aplicación"
                           FontSize="14" Foreground="#CCC" HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- Progress tips -->
                <Border Background="#333333" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Qué está pasando:" FontWeight="Bold" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="• Verificando conexión con el teléfono..." Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="• Creando backup de seguridad..." Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="• Preparando archivos de root..." Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="• Esto puede tardar 5-15 minutos según el teléfono"
                                   Foreground="#666" FontSize="11" FontStyle="Italic" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Hang help -->
                <Border Background="#37474F" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="¿Se quedó colgado?" FontWeight="Bold" Foreground="#FFA726" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#B0BEC5" FontSize="11">
                            Si no ves cambios en 10 minutos, el proceso puede haberse detenido.<LineBreak/>
                            • Mantén presionado el botón de encendido 10 segundos para reiniciar<LineBreak/>
                            • La app se recuperará automáticamente<LineBreak/>
                            • Tus datos están seguros — no se modifica nada permanente aún
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Command="{Binding CancelRootCommand}"
                        Content="CANCELAR"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="#EF5350" Foreground="White"
                        HorizontalAlignment="Center" Padding="24,8" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
